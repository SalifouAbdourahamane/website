# Copy to .env.local for development; set the same names in Vercel (Project → Settings → Environment Variables).
# The public pages build and run without any of these; accounts and the live demos switch on when they are set.

# Supabase (Project Settings → API). The anon key is public by design; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. The same value as the Modal secret `namu-key-pepper` (NAMU_KEY_PEPPER). At least 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
NAMU_KEY_PEPPER=

# Server-only. A normal API key created in the dashboard, then marked is_demo (see supabase/migrations).
NAMU_DEMO_KEY=

# The public API base developers call. Defaults to the Modal gateway URL.
NEXT_PUBLIC_NAMU_API_BASE=https://abdoulide71--namu-gateway-api.modal.run

# Optional extra sign-in buttons, once the providers are enabled in Supabase Auth: google,github
NEXT_PUBLIC_AUTH_PROVIDERS=
